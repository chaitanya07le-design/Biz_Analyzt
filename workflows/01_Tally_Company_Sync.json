          "displayName": "Transform Companies",
          "settings": {
            "input": {
              "tally_data": "{{step_1['output']}}"
            },
            "sampleData": {},
            "sourceCode": {
              "code": "export const code = async (inputs) => {\n  const tallyData = inputs.tally_data || {};\n  const companies = tallyData.companies || [];\n  const now = new Date().toISOString().replace('T', ' ').substring(0, 19);\n  \n  const rows = companies.map((item, index) => {\n    const companyID = `COMP-${String(index + 1).padStart(4, '0')}`;\n    return [\n      companyID,\n      item.name || '',\n      item.address || '',\n      item.gstin || '',\n      item.financialYearStart || '01-Apr',\n      item.currency || 'INR',\n      'TRUE',\n      now,\n      now,\n      1\n    ];\n  });\n  \n  return { rows, count: rows.length };\n};",
              "packageJson": "{}",
              "language": "typescript"
            },
            "errorHandlingOptions": {
              "retryOnFailure": {"value": false},
              "continueOnFailure": {"value": false}
            }
          },
          "nextAction": {
