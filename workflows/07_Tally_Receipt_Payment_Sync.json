              "sampleData": {},
              "sourceCode": {
                "code": "export const code = async (inputs) => {\n  const tallyData = inputs.tally_data || {};\n  const vouchers = tallyData.vouchers || [];\n  const now = new Date().toISOString().replace('T', ' ').substring(0, 19);\n  \n  const rows = vouchers.map((item, index) => {\n    const voucherID = `VCH-${String(index + 1).padStart(4, '0')}`;\n    return [\n      voucherID,\n      'COMP-0001',\n      item.voucherNo || '',\n      'Receipt',\n      item.date || '',\n      item.partyGuid || '',\n      item.referenceNo || '',\n      item.narration || '',\n      item.subTotal || 0,\n      item.gstTotal || 0,\n      item.roundOff || 0,\n      item.grandTotal || 0,\n      'FALSE',\n      now,\n      now,\n      'USER-0001',\n      'USER-0001',\n      1\n    ];\n  });\n  \n  return { rows, count: rows.length };\n};",
                "packageJson": "{}",
                "language": "typescript"
              },
