            "sampleData": {},
            "sourceCode": {
              "code": "export const code = async (inputs) => {\n  const tallyData = inputs.tally_data || {};\n  const groups = tallyData.groups || [];\n  const now = new Date().toISOString().replace('T', ' ').substring(0, 19);\n  \n  const rows = groups.map((item, index) => {\n    const groupID = `GRP-${String(index + 1).padStart(4, '0')}`;\n    return [\n      groupID,\n      'COMP-0001',\n      item.name || '',\n      item.groupType || 'Assets',\n      item.parentGuid || '',\n      item.isSystem ? 'TRUE' : 'FALSE',\n      now,\n      now,\n      1\n    ];\n  });\n  \n  return { rows, count: rows.length };\n};",
              "packageJson": "{}",
              "language": "typescript"
            },
