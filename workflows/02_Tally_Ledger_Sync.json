                  "sourceCode": {
                    "code": "export const code = async (inputs) => {\n  const tallyData = inputs.tally_data || {};\n  const ledgers = tallyData.ledgers || [];\n  const now = new Date().toISOString().replace('T', ' ').substring(0, 19);\n  \n  const rows = ledgers.map((item, index) => {\n    const ledgerID = `LDG-${String(index + 1).padStart(4, '0')}`;\n    return [\n      ledgerID,\n      'COMP-0001',\n      item.name || '',\n      item.groupGuid || '',\n      item.openingBalance || 0,\n      item.isSystem ? 'TRUE' : 'FALSE',\n      now,\n      now,\n      1\n    ];\n  });\n  \n  return { rows, count: rows.length };\n};",
