              "sampleData": {},
              "sourceCode": {
                "code": "export const code = async (inputs) => {\n  const tallyData = inputs.tally_data || {};\n  const itemGroups = tallyData.itemGroups || [];\n  const now = new Date().toISOString().replace('T', ' ').substring(0, 19);\n  \n  const rows = itemGroups.map((item, index) => {\n    const groupID = `IGRP-${String(index + 1).padStart(4, '0')}`;\n    return [\n      groupID,\n      'COMP-0001',\n      item.itemGroupName || '',\n      item.categoryId || '',\n      now,\n      now,\n      1\n    ];\n  });\n  \n  return { rows, count: rows.length };\n};",
