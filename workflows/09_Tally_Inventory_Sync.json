                    "sampleData": {},
                    "sourceCode": {
                      "code": "export const code = async (inputs) => {\n  const tallyData = inputs.tally_data || {};\n  const items = tallyData.items || [];\n  const now = new Date().toISOString().replace('T', ' ').substring(0, 19);\n  \n  const rows = items.map((item, index) => {\n    const itemID = `ITM-${String(index + 1).padStart(4, '0')}`;\n    return [\n      itemID,\n      'COMP-0001',\n      item.itemName || '',\n      item.categoryId || '',\n      item.itemGroupId || '',\n      item.hsnCode || '',\n      item.unit || '',\n      item.gstRate || 0,\n      item.saleRate || 0,\n      item.purchaseRate || 0,\n      item.openingStock || 0,\n      item.openingValue || 0,\n      item.reorderLevel || 0,\n      item.isActive ? 'TRUE' : 'TRUE',\n      now,\n      now,\n      1\n    ];\n  });\n  \n  return { rows, count: rows.length };\n};",
                      "packageJson": "{}",
                      "language": "typescript"
