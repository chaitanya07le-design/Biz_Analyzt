                    "sourceCode": {
                      "code": "export const code = async (inputs) => {\n  const now = new Date().toISOString().replace('T', ' ').substring(0, 19);\n  const rows = [];\n  let lineIndex = 1;\n  \n  const processLines = (lines) => {\n    (lines || []).forEach((item) => {\n      const lineID = `LIN-${String(lineIndex++).padStart(4, '0')}`;\n      rows.push([\n        lineID,\n        item.voucherGuid || '',\n        item.lineType || 'Ledger',\n        item.itemGuid || '',\n        item.ledgerGuid || '',\n        item.description || '',\n        item.quantity || 0,\n        item.rate || 0,\n        item.amount || 0,\n        item.gstRate || 0,\n        item.gstAmount || 0,\n        item.ledgerDebit || 0,\n        item.ledgerCredit || 0,\n        item.sortOrder || lineIndex,\n        now,\n        now\n      ]);\n    });\n  };\n  \n  processLines(inputs.debit_data?.voucherLines || []);\n  processLines(inputs.credit_data?.voucherLines || []);\n  processLines(inputs.journal_data?.voucherLines || []);\n  \n  return { rows, count: rows.length };\n};",
                      "packageJson": "{}",
