                "sampleData": {},
                "sourceCode": {
                  "code": "export const code = async (inputs) => {\n  const now = new Date().toISOString().replace('T', ' ').substring(0, 19);\n  const rows = [];\n  let voucherIndex = 1;\n  \n  const processVouchers = (vouchers, type) => {\n    (vouchers || []).forEach((item) => {\n      const voucherID = `VCH-${String(voucherIndex++).padStart(4, '0')}`;\n      rows.push([\n        voucherID,\n        'COMP-0001',\n        item.voucherNo || '',\n        type,\n        item.date || '',\n        item.partyGuid || '',\n        item.referenceNo || '',\n        item.narration || '',\n        item.subTotal || 0,\n        item.gstTotal || 0,\n        item.roundOff || 0,\n        item.grandTotal || 0,\n        'FALSE',\n        now,\n        now,\n        'USER-0001',\n        'USER-0001',\n        1\n      ]);\n    });\n  };\n  \n  processVouchers(inputs.debit_data?.vouchers || [], 'Debit Note');\n  processVouchers(inputs.credit_data?.vouchers || [], 'Credit Note');\n  processVouchers(inputs.journal_data?.vouchers || [], 'Journal');\n  \n  return { rows, count: rows.length };\n};",
                  "packageJson": "{}",
                  "language": "typescript"
                },
