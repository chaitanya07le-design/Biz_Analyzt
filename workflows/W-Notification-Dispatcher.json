                                    "code": "export const code = async (inputs) => {\n  const events = inputs.events || [];\n  // Only keep events where 'email' is a channel AND recipientEmail actually resolved to something non-empty\n  const emailEvents = events.filter(e => Array.isArray(e.channels) && e.channels.includes(\"email\") && e.email);\n  return { emailEvents };\n};",
