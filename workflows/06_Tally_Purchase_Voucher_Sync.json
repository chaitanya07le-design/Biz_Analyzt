                "sampleData": {},
                "sourceCode": {
                  "code": "export const code = async (inputs) => {\n  const tallyData = inputs.tally_data || {};\n  const lines = tallyData.voucherLines || [];\n  const now = new Date().toISOString().replace('T', ' ').substring(0, 19);\n  \n  const rows = lines.map((item, index) => {\n    const lineID = `LIN-${String(index + 1).padStart(4, '0')}`;\n    return [\n      lineID,\n      item.voucherGuid || '',\n      item.lineType || 'Item',\n      item.itemGuid || '',\n      item.ledgerGuid || '',\n      item.description || '',\n      item.quantity || 0,\n      item.rate || 0,\n      item.amount || 0,\n      item.gstRate || 0,\n      item.gstAmount || 0,\n      item.ledgerDebit || 0,\n      item.ledgerCredit || 0,\n      item.sortOrder || index + 1,\n      now,\n      now\n    ];\n  });\n  \n  return { rows, count: rows.length };\n};",
                  "packageJson": "{}",
