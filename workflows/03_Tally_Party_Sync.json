            "sampleData": {},
            "sourceCode": {
              "code": "export const code = async (inputs) => {\n  const tallyData = inputs.tally_data || {};\n  const parties = tallyData.parties || [];\n  const now = new Date().toISOString().replace('T', ' ').substring(0, 19);\n  \n  const rows = parties.map((item, index) => {\n    const partyID = `PTY-${String(index + 1).padStart(4, '0')}`;\n    return [\n      partyID,\n      'COMP-0001',\n      item.name || '',\n      'Customer',\n      '',\n      item.contactPerson || '',\n      item.phone || '',\n      item.email || '',\n      item.address || '',\n      item.gstin || '',\n      item.openingBalance || 0,\n      item.creditLimit || 0,\n      item.creditDays || 0,\n      now,\n      now,\n      1\n    ];\n  });\n  \n  return { rows, count: rows.length };\n};",
