            "sampleData": {},
            "sourceCode": {
              "code": "export const code = async (inputs) => {\n  let rawData = typeof inputs.tally_data === 'string' ? JSON.parse(inputs.tally_data || '[]') : (inputs.tally_data || []);\n  let data = [];\n  \n  if (Array.isArray(rawData) && rawData.length > 0 && rawData[0]['Json Agg']) {\n    try { data = JSON.parse(rawData[0]['Json Agg']); } catch(e) { data = []; }\n  } else { data = rawData; }\n  \n  if (!Array.isArray(data)) data = [];\n  \n  const today = new Date();\n  const current_date = `${String(today.getDate()).padStart(2, \"0\")}/${String(today.getMonth() + 1).padStart(2, \"0\")}/${today.getFullYear()}`;\n  \n  const getNum = (v) => parseFloat(String(v || '0').replace(/[^0-9.-]/g, '')) || 0;\n  \n  const rows = [];\n  let urgentCount = 0, reminderCount = 0, skipCount = 0;\n  let urgentAmt = 0, reminderAmt = 0, totalAmt = 0;\n  \n  // Sorted by fallback fields tracking 'total_pending_amount' first to match your uploaded data schema\n  const sortedData = data.sort((a,b) => getNum(b.total_pending_amount || b.total_outstanding_inr || b.amount) - getNum(a.total_pending_amount || a.total_outstanding_inr || a.amount));\n  \n  sortedData.forEach(d => {\n    // Check fallback for amount field names\n    const amt = getNum(d.total_pending_amount || d.total_outstanding_inr || d.amount);\n    \n    // Check fallback for days overdue field names\n    const days = parseInt(d.max_overdue_days || d.days_overdue || d.days || '0');\n    \n    let tier = 'SKIP';\n    if (days > 45) { \n      tier = 'URGENT'; \n      urgentCount++; \n      urgentAmt += amt; \n    } else if (days >= 15) { \n      tier = 'REMINDER'; \n      reminderCount++; \n      reminderAmt += amt; \n    } else { \n      tier = 'SAFE'; \n      skipCount++; \n    }\n    \n    totalAmt += amt;\n    \n    rows.push({\n      party_name: String(d.party_name || d.party || 'Unknown'),\n      amount: String(amt),\n      days_overdue: String(days),\n      tier: tier,\n      phone: String(d.mobile || d.contact_phone || d.phone || ''), // Added 'mobile' fallback to parse phone numbers correctly\n      message: tier === 'URGENT' ? 'Immediate payment required' : (tier === 'REMINDER' ? 'Payment reminder sent' : ''),\n      current_date: current_date\n    });\n  });\n  \n  const topUrgent = rows.filter(r => r.tier === 'URGENT').slice(0, 5).map(r => `${r.party_name} (₹${r.amount}, ${r.days_overdue} days)`).join('; ');\n  \n  const llmSummary = `\\n    Total Outstanding: ₹${totalAmt.toFixed(2)}\\n    URGENT (>45 days): ${urgentCount} parties, Total: ₹${urgentAmt.toFixed(2)}. Top defaulters: ${topUrgent || 'None'}\\n    REMINDER (15-45 days): ${reminderCount} parties, Total: ₹${reminderAmt.toFixed(2)}\\n    SAFE (<15 days): ${skipCount} parties\\n  `;\n  \n  return { \n    success: true, \n    sheet_rows: rows, \n    llmSummary, \n    has_urgent: urgentCount > 0 ? \"true\" : \"false\", \n    urgentCount, \n    urgentAmt, \n    reminderCount, \n    reminderAmt, \n    totalAmt, \n    topUrgentText: topUrgent || 'None' \n  };\n};",
