export const getPartyById = (id) => parties.find(p => p.id === id);

export const getItemById = (id) => items.find(i => i.id === id);

export const getLedgerById = (id) => ledgers.find(l => l.id === id);

export const getVoucherById = (id) => {
  return salesVouchers.find(v => v.id === id) ||
         purchaseVouchers.find(v => v.id === id) ||
         receiptVouchers.find(v => v.id === id) ||
         paymentVouchers.find(v => v.id === id) ||
         salesOrders.find(v => v.id === id) ||
         purchaseOrders.find(v => v.id === id) ||
         deliveryNotes.find(v => v.id === id) ||
         receiptNotes.find(v => v.id === id) ||
         journalEntries.find(v => v.id === id);
};

export const getLedgerTransactions = (partyId) => {
  const party = parties.find(p => p.id === partyId);
  const openingBalance = party?.openingBalance || 0;
  
  const transactions = [];
  
  salesVouchers.filter(v => v.partyId === partyId).forEach(v => {
    transactions.push({
      date: v.date,
      voucherNo: v.voucherNo,
      voucherId: v.id,
      type: v.type,
      particulars: 'Sales Invoice',
      debit: 0,
      credit: v.netAmount,
      amount: v.netAmount,
    });
  });
  
  receiptVouchers.filter(v => v.partyId === partyId).forEach(v => {
    transactions.push({
      date: v.date,
      voucherNo: v.voucherNo,
      voucherId: v.id,
      type: v.type,
      particulars: 'Receipt',
      debit: v.grossTotal,
      credit: 0,
      amount: -v.grossTotal,
    });
  });
  
  transactions.sort((a, b) => {
    const dateCompare = new Date(a.date) - new Date(b.date);
    if (dateCompare !== 0) return dateCompare;
    if (!a.voucherNo && b.voucherNo) return 1;
    if (a.voucherNo && !b.voucherNo) return -1;
    return 0;
  });
  
  let runningBalance = openingBalance;
  transactions.forEach(t => {
    runningBalance += t.amount;
    t.balance = runningBalance;
  });
  
  return { transactions, openingBalance };
};

export const getMonthlyData = (voucherData) => {
  const monthlyTotals = {};
  
  voucherData.forEach(v => {
    const date = new Date(v.date);
    const monthKey = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
    
    if (!monthlyTotals[monthKey]) {
      monthlyTotals[monthKey] = 0;
    }
    monthlyTotals[monthKey] += v.netAmount;
  });
  
  const sortedMonths = Object.keys(monthlyTotals).sort();
  const last6Months = sortedMonths.slice(-6);
  
  return last6Months.map(month => {
    const date = new Date(month + '-01');
    const monthName = date.toLocaleDateString('en-US', { month: 'short' });
    return {
      label: monthName,
      value: monthlyTotals[month],
      month: month,
    };
  });
};

export const getVoucherTypeConfig = (type) => {
  const configs = {
    'Sales': { color: 'blue', icon: 'sales', requiresEInvoice: true },
    'Purchase': { color: 'purple', icon: 'purchase', requiresEInvoice: true },
    'Receipt': { color: 'green', icon: 'receipt', requiresEInvoice: false },
    'Payment': { color: 'red', icon: 'payment', requiresEInvoice: false },
    'Sales Order': { color: 'blue', icon: 'order', requiresEInvoice: false },
    'Purchase Order': { color: 'purple', icon: 'order', requiresEInvoice: false },
    'Delivery Note': { color: 'teal', icon: 'truck', requiresEInvoice: false },
    'Receipt Note': { color: 'orange', icon: 'package', requiresEInvoice: false },
    'Journal': { color: 'gray', icon: 'journal', requiresEInvoice: false },
  };
  return configs[type] || { color: 'gray', icon: 'document', requiresEInvoice: false };
};
